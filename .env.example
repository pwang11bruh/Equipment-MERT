# -----------------------------------------------------------------------------
# Copy to .env.local and fill in. NEVER commit .env.local.
# See docs/operations/ENVIRONMENT.md for where each value comes from.
# -----------------------------------------------------------------------------

# --- Supabase CLI only (not read by the app) --------------------------------
# Personal access token (supabase.com/dashboard/account/tokens) and the DB
# password chosen at project creation. Load before CLI commands:
#   set -a; source .env.local; set +a
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=

# Supabase (Project Settings -> API). Local: values printed by `npx supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the member PIN session cookie and salts client IP hashes. 32+ random chars:
#   openssl rand -base64 48
MEMBER_SESSION_SECRET=
# How long a member stays unlocked after entering the PIN (hours).
MEMBER_SESSION_HOURS=12

# Protects /api/cron/* (Vercel Cron sends `Authorization: Bearer $CRON_SECRET`).
CRON_SECRET=

# Public URL of the deployed app (used in alert emails/SMS links).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Email alerts (https://resend.com). Leave blank to disable email.
RESEND_API_KEY=
ALERT_EMAIL_FROM="MERT Equipment <alerts@example.org>"

# SMS alerts (https://twilio.com). Leave blank to disable SMS.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
